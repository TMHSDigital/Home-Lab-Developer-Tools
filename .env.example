# Raspberry Pi SSH connection
HOMELAB_PI_HOST=raspberrypi.local
HOMELAB_PI_USER=pi
HOMELAB_PI_KEY_PATH=~/.ssh/id_ed25519

# Compose project directory on the Pi
HOMELAB_COMPOSE_DIR=/opt/homelab/docker

# Compose files used when a compose tool is called without `stacks` (comma-separated, in order).
# If unset, the tools discover compose.base.yml and every compose.*.yml in HOMELAB_COMPOSE_DIR,
# falling back to compose.yaml / compose.yml / docker-compose.yaml / docker-compose.yml.
# HOMELAB_COMPOSE_FILES=compose.base.yml,compose.monitoring.yml

# Backup repo path on the Pi
HOMELAB_BACKUP_REPO=/mnt/backup/restic

# Grafana authentication (pick one method)
# Option 1: API token (preferred)
# HOMELAB_GRAFANA_TOKEN=glsa_xxxxxxxxxxxx
# Option 2: Basic auth (defaults to admin/admin if neither is set)
# HOMELAB_GRAFANA_USER=admin
# HOMELAB_GRAFANA_PASSWORD=your-password

# AdGuard Home authentication (defaults to admin/admin)
# HOMELAB_ADGUARD_USER=admin
# HOMELAB_ADGUARD_PASSWORD=your-password

# Nginx Proxy Manager authentication (defaults to admin@example.com/changeme)
# HOMELAB_NPM_EMAIL=admin@example.com
# HOMELAB_NPM_PASSWORD=your-password

# Service port overrides (defaults shown -- only set if you remap ports)
# HOMELAB_PROMETHEUS_PORT=9090
# HOMELAB_GRAFANA_PORT=3000
# HOMELAB_ALERTMANAGER_PORT=9093
# HOMELAB_UPTIME_KUMA_PORT=3001
# HOMELAB_SPEEDTEST_PORT=8765
# HOMELAB_ADGUARD_PORT=3000    # AdGuard and Grafana both default to 3000: set this if Grafana owns 3000
# HOMELAB_NPM_PORT=81
# HOMELAB_NTFY_PORT=8080

# Uptime Kuma status page slug for homelab_uptimeKumaStatus (default: default)
# HOMELAB_UPTIME_KUMA_SLUG=default

# Default ntfy topics for homelab_ntfyTopics (comma-separated; ntfy has no "all topics" query)
# HOMELAB_NTFY_TOPICS=alerts,backups

# Multi-node support (JSON object mapping node names to SSH config)
# HOMELAB_NODES='{"nas":{"host":"nas.local","user":"admin","keyPath":"~/.ssh/id_ed25519"},"pi-zero":{"host":"pizero.local","user":"pi","keyPath":"~/.ssh/id_ed25519"}}'

# Ansible inventory path for node discovery (default /etc/ansible/hosts)
# HOMELAB_ANSIBLE_INVENTORY=/etc/ansible/hosts

# Safety overrides
# HOMELAB_DRY_RUN=true           # true/1/yes/on: execSSH prints what it would run without connecting
# HOMELAB_ALLOW_DANGEROUS_COMMANDS=true  # Bypasses the runtime command guard (use with caution)

# Default SSH timeout in ms for tools without their own budget (default 30000).
# Long-running tools (apt upgrade, compose pull, restic, trivy) use longer built-in timeouts.
# HOMELAB_SSH_TIMEOUT_MS=30000
